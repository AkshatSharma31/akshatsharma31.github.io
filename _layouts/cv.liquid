---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }} {% if page.cv_pdf %}<a href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}" target="_blank" rel="noopener noreferrer" class="float-right"><i class="fas fa-file-pdf"></i></a>{% endif %}</h1>
    {% if page.description %}<p class="post-description">{{ page.description }}</p>{% endif %}
  </header>

  <article>
    <div class="cv">
      {% assign cv_data = site.data.cv.cv %}
      
      {% for section in cv_data.sections %}
        {% assign section_title = section[0] %}
        {% assign section_entries = section[1] %}
        
        <a class="anchor" id="{{ section_title | slugify }}"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">{{ section_title }}</h3>
          <div>
            
            {% if section_title == 'Summary' %}
              <ul class="card-text font-weight-light list-group list-group-flush">
                {% for entry in section_entries %}
                  <li class="list-group-item"><p style="margin-bottom: 0;">{{ entry }}</p></li>
                {% endfor %}
              </ul>
            
            {% else %}
              <ul class="card-text font-weight-light list-group list-group-flush">
                {% for entry in section_entries %}
                  <li class="list-group-item">
                    <div class="row">
                      
                      <!-- LEFT COLUMN: The classic al-folio Badges and Location Icons -->
                      <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
                        <table class="table-cv">
                          <tbody>
                            <tr>
                              <td>
                                {% if entry.date %}
                                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
                                    {{ entry.date }}
                                  </span>
                                {% elsif entry.label %}
                                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
                                    {{ entry.label }}
                                  </span>
                                {% elsif entry.name and section_title != 'Awards' %}
                                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
                                    {{ entry.name }}
                                  </span>
                                {% endif %}
                              </td>
                            </tr>
                            {% if entry.location %}
                              <tr>
                                <td>
                                  <p class="location">
                                    <i class="fas fa-map-marker-alt iconlocation"></i> {{ entry.location }}
                                  </p>
                                </td>
                              </tr>
                            {% endif %}
                          </tbody>
                        </table>
                      </div>
                      
                      <!-- RIGHT COLUMN: The Content -->
                      <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
                        
                        {% if section_title == 'Experience' or section_title == 'Positions of Responsibility' %}
                          <h6 class="title font-weight-bold ml-1 ml-md-4">{{ entry.position }}</h6>
                          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ entry.company }}</h6>
                          {% if entry.summary %}
                            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ entry.summary }}</h6>
                          {% endif %}
                          {% if entry.highlights %}
                            <ul class="items">
                              {% for highlight in entry.highlights %}
                                <li><span class="item">{{ highlight }}</span></li>
                              {% endfor %}
                            </ul>
                          {% endif %}

                        {% elsif section_title == 'Education' %}
                          <h6 class="title font-weight-bold ml-1 ml-md-4">{{ entry.institution }}</h6>
                          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ entry.degree }} {% if entry.area %}in {{ entry.area }}{% endif %}</h6>
                          {% if entry.highlights %}
                            <ul class="items">
                              {% for highlight in entry.highlights %}
                                <li><span class="item">{{ highlight }}</span></li>
                              {% endfor %}
                            </ul>
                          {% endif %}

                        {% elsif section_title == 'Publications' %}
                          <h6 class="title font-weight-bold ml-1 ml-md-4">{{ entry.title }}</h6>
                          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">
                            {% if entry.authors %}{{ entry.authors | join: ", " }}<br>{% endif %}
                            <em>{{ entry.journal }}</em>
                            {% if entry.doi %} | DOI: {{ entry.doi }}{% endif %}
                            {% if entry.url %} | <a href="{{ entry.url }}" target="_blank">Link</a>{% endif %}
                          </h6>
                          {% if entry.summary %}
                            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ entry.summary }}</h6>
                          {% endif %}

                        {% elsif section_title == 'Awards' %}
                          <h6 class="title font-weight-bold ml-1 ml-md-4">{{ entry.name }}</h6>
                          {% if entry.summary %}
                            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ entry.summary }}</h6>
                          {% endif %}

                        {% else %}
                          <div class="ml-1 ml-md-4" style="font-size: 0.95rem;">
                            {% if entry.details %}{{ entry.details }}{% endif %}
                            {% if entry.keywords %}{{ entry.keywords }}{% endif %}
                            {% if entry.details == nil and entry.keywords == nil and entry.label == nil and entry.name == nil %}
                              {{ entry }}
                            {% endif %}
                          </div>
                        {% endif %}
                        
                      </div>
                    </div>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
            
          </div>
        </div>
      {% endfor %}
    </div>
  </article>
</div>
