---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }} {% if page.cv_pdf %}<a href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}" target="_blank" rel="noopener noreferrer" class="float-right"><i class="fas fa-file-pdf"></i></a>{% endif %}</h1>
    {% if page.description %}<p class="post-description">{{ page.description }}</p>{% endif %}
  </header>

  <article>
    <div class="cv">
      {% assign cv_data = site.data.cv.cv %}
      
      {% for section in cv_data.sections %}
        {% assign section_title = section[0] %}
        {% assign section_entries = section[1] %}
        
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">{{ section_title }}</h3>
          <div>
          {% for entry in section_entries %}
            
            {% if section_title == 'Summary' %}
              <p class="font-weight-light mb-0">{{ entry }}</p>
            
            {% elsif section_title == 'Experience' %}
              <div class="row mb-3">
                <div class="col-sm-3 text-sm-right text-muted">
                  <small>{{ entry.date }}</small><br>
                  <small>{{ entry.location }}</small>
                </div>
                <div class="col-sm-9">
                  <h6 class="mb-0 font-weight-bold">{{ entry.company }}</h6>
                  <p class="mb-1 font-italic">{{ entry.position }}</p>
                  {% if entry.summary %}<p class="mb-1 small">{{ entry.summary }}</p>{% endif %}
                  {% if entry.highlights %}
                    <ul class="mb-0 small text-muted">
                      {% for highlight in entry.highlights %}<li>{{ highlight }}</li>{% endfor %}
                    </ul>
                  {% endif %}
                </div>
              </div>

            {% elsif section_title == 'Education' %}
              <div class="row mb-3">
                <div class="col-sm-3 text-sm-right text-muted">
                  <small>{{ entry.date }}</small><br>
                  <small>{{ entry.location }}</small>
                </div>
                <div class="col-sm-9">
                  <h6 class="mb-0 font-weight-bold">{{ entry.institution }}</h6>
                  <p class="mb-1 font-italic">{{ entry.degree }} {% if entry.area %}in {{ entry.area }}{% endif %}</p>
                  {% if entry.highlights %}
                    <ul class="mb-0 small text-muted">
                      {% for highlight in entry.highlights %}<li>{{ highlight }}</li>{% endfor %}
                    </ul>
                  {% endif %}
                </div>
              </div>

            {% elsif section_title == 'Publications' %}
              <div class="row mb-3">
                <div class="col-sm-3 text-sm-right text-muted">
                  <small>{{ entry.date }}</small>
                </div>
                <div class="col-sm-9">
                  <h6 class="mb-0 font-weight-bold">{{ entry.title }}</h6>
                  <p class="mb-1 small">
                    {% if entry.authors %}{{ entry.authors | join: ", " }}<br>{% endif %}
                    <em>{{ entry.journal }}</em>
                    {% if entry.doi %} | DOI: {{ entry.doi }}{% endif %}
                    {% if entry.url %} | <a href="{{ entry.url }}">Link</a>{% endif %}
                  </p>
                  {% if entry.summary %}<p class="mb-0 small text-muted">{{ entry.summary }}</p>{% endif %}
                </div>
              </div>

            {% elsif section_title == 'Awards' %}
              <div class="row mb-3">
                <div class="col-sm-3 text-sm-right text-muted">
                  <small>{{ entry.date }}</small>
                </div>
                <div class="col-sm-9">
                  <h6 class="mb-0 font-weight-bold">{{ entry.name }}</h6>
                  {% if entry.summary %}<p class="mb-0 small text-muted">{{ entry.summary }}</p>{% endif %}
                </div>
              </div>

            {% elsif section_title == 'Positions of Responsibility' %}
              <div class="row mb-3">
                <div class="col-sm-3 text-sm-right text-muted">
                  <small>{{ entry.date }}</small><br>
                  <small>{{ entry.location }}</small>
                </div>
                <div class="col-sm-9">
                  <h6 class="mb-0 font-weight-bold">{{ entry.company }}</h6>
                  <p class="mb-1 font-italic">{{ entry.position }}</p>
                </div>
              </div>

            {% elsif entry.label or entry.name %}
              <div class="row mb-2">
                <div class="col-sm-3 text-sm-right font-weight-bold">
                  {% if entry.label %}{{ entry.label }}{% else %}{{ entry.name }}{% endif %}
                </div>
                <div class="col-sm-9 font-weight-light">
                  {% if entry.details %}{{ entry.details }}{% endif %}
                  {% if entry.keywords %}{{ entry.keywords }}{% endif %}
                </div>
              </div>

            {% else %}
              <p class="font-weight-light">{{ entry }}</p>
            {% endif %}

          {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </article>
</div>
